<?xml version="1.0" encoding="utf-8"?>
<!--
    Security hardening: Exclude all app data from cloud backup.
    The device stores PIN throttle state and cached menu items —
    neither should be backed up to Google Drive.

    Note: android:allowBackup="false" is already set in the manifest,
    but these rules provide defense-in-depth if that flag is ever changed.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
